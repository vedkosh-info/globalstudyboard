# GlobalStudyBoard — environment variables. Copy to .env.local (gitignored) for
# local development; set the same names in Vercel → Project → Environment
# Variables. NEXT_PUBLIC_* values are inlined at BUILD time — a Vercel change
# does nothing until a redeploy. Flags compare against the exact lowercase
# string 'true'.

# ── GSB AI (Gemini via @ai-sdk/google) ─────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Android beta-tester sign-up → Google Sheet (scripts/apps-script/) ──────────
# Server-only. Unset = the form answers 503. Leave unset in Preview and (usually)
# in local dev, or test submissions write real rows into the live tester sheet.
# TESTER_INVITE_SCRIPT_URL=

# ── Accounts (Supabase Auth) — September 2026 ─────────────────────────────────
# Project "globalstudyboard" (ref xrfcxocqqshfilseojau, AWS ap-south-1 Mumbai) in
# the vedkosh-info org — a SEPARATE project from VedKosh's; users never mix.
# Both public vars unset = accounts DORMANT: no sign-in control renders and the
# account routes answer 503. The publishable key is public by design (RLS is the
# gate). Legacy names NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are
# accepted as fallbacks.
NEXT_PUBLIC_SUPABASE_URL=https://xrfcxocqqshfilseojau.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — bypasses RLS (account deletion, owner console). Never NEXT_PUBLIC_,
# never commit, never set in Vercel *Preview* (branch builds would reach prod data).
SUPABASE_SECRET_KEY=
# Comma-separated owner e-mails allowed into /admin (matched case-insensitively
# against the server-verified Supabase session e-mail). Unset = no admins.
ADMIN_EMAILS=
# 'true' ONLY after Google is enabled in Supabase → Auth → Sign In / Providers.
# The button then appears; before that a click would show visitors a raw
# "Unsupported provider" JSON error.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# 'true' ONLY after custom SMTP is configured AND the "Magic link or OTP" e-mail
# template prints {{ .Token }}. Until then the e-mail carries a sign-in LINK
# only and the form's copy says so.
NEXT_PUBLIC_EMAIL_OTP_CODE=false
