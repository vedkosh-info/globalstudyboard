# Image pipeline — source PNGs from Gemini are LOCAL ONLY.
# Only the optimised .avif/.webp variants ship, so the repo stays light.
image-pipeline/raw/
public/images/**/*.png

# Bake-off scratch output — never ships.
image-pipeline/bakeoff/

# Local API keys for the image pipeline — NEVER commit.
image-pipeline/.env

